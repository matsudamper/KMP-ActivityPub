type UserInfo {
    """
    購読先 1 つの行を新しい順に返す。followingGroupId が null ならメイン（グループに入れていないフォローと自分の投稿）。
    after には前回の nextCursor を渡す。消された投稿も deleted を立てて返す
    """
    timeline(followingGroupId: FollowingGroupId, after: String, limit: Int!): TimelinePage @lazy
    "自分の投稿に届いたお気に入りとブーストを新しい順に返す。after には前回の nextCursor を渡す"
    notifications(after: String, limit: Int!): NotificationPage @lazy
    """
    投稿の本文にあるリンク先の OGP。postId には TimelinePost.id か ProfilePost.id を渡す。
    リンク先へ取りに行くので遅い。読めない投稿か、保存していない他のサーバーの投稿か、サーバーに DOMAIN が無ければ空
    """
    linkPreviews(postId: TimelinePostId!): [LinkPreview!]! @lazy
    """
    個別投稿画面に出す投稿を 1 件。id には TimelinePost.id か ProfilePost.id を渡す。
    タイムラインに載る投稿に加えて、プロフィールに並ぶ投稿も開ける。保存していない他のサーバーの投稿は取ってきて保存する。開けない投稿なら null
    """
    timelinePost(id: TimelinePostId!): TimelinePost @lazy
    """
    postId の投稿の返信先。postId には TimelinePost.id を渡す。返した投稿の id を渡せば、さらに返信先をたどれる。
    保存していない他のサーバーの投稿は、相手のサーバーから取って保存せずに返すので遅い。その id と reactionPostId は保存していない投稿を指し、いいねやブーストを付けたときに保存する。
    返信でないか、返信先を読めないか、サーバーに DOMAIN が無ければ null。返信先のサーバーが応えなければ、null とエラーを返す
    """
    replyTarget(postId: TimelinePostId!): TimelinePost @lazy
    """
    投稿のリプライ・いいね・ブーストの数。id には TimelinePost.id か ProfilePost.id を渡す。開けない投稿なら null。
    他のサーバーの投稿は、前に取ってから 1 分経っていれば相手のサーバーから数を取り直すので遅い。個別投稿画面を開いたときに使う
    """
    postCounts(postId: TimelinePostId!): PostCounts @lazy
    """
    postId の投稿の引用先。postId には TimelinePost.id を渡す。読み方と返す投稿は replyTarget と同じ。
    引用でないか、引用先を読めないか、サーバーに DOMAIN が無ければ null。引用先のサーバーが応えなければ、null とエラーを返す
    """
    quoteTarget(postId: TimelinePostId!): TimelinePost @lazy
    """
    postId の投稿への返信を古い順に 100 件まで。postId には TimelinePost.id を渡す。ブーストで載った投稿は、ブーストされた元の投稿への返信。
    このサーバーが保存している投稿だけを返し、相手のサーバーへは取りに行かない。消された返信とブロックした相手の返信は入らない。
    読めない投稿か、サーバーに DOMAIN が無ければ空
    """
    replies(postId: TimelinePostId!): [TimelinePost!]! @lazy
    """
    postId の投稿の版を新しい順に返す。最初が今の版。postId には TimelinePost.id を渡す。ブーストで載った投稿は、ブーストされた元の投稿の版。
    after には前回の nextCursor を渡す。このサーバーが編集を受け取った分だけを返し、相手のサーバーへは取りに行かない。
    編集を受け取っていなければ今の版だけ。開けない投稿なら null
    """
    postRevisions(postId: TimelinePostId!, after: String, limit: Int!): PostRevisionPage @lazy
    id: UserId!
    "サーバーの ADMIN_USER_IDS に入っていれば true。管理画面に入れる"
    isAdmin: Boolean!
    """
    送るのを諦めた配信を新しく積んだ順に返す。after には前回の nextCursor を渡す。limit は 100 までに縮める。
    管理者でなければエラー
    """
    failedDeliveries(after: String, limit: Int!): FailedDeliveryPage! @lazy
    "送るのを諦めた配信を 1 件。無ければ null。管理者でなければエラー"
    failedDelivery(id: FailedDeliveryId!): FailedDelivery @lazy
    "フォローを仕分けるグループ。作った順"
    followingGroups: [FollowingGroup!]! @lazy
    "どのグループにも入れていないフォローを入れるメインの名前"
    mainGroupName: String! @lazy
    """
    ブロックしている他のサーバーのホスト。新しくブロックした順。
    ブロックしたサーバーのアクターから自分宛てに届く投稿・お気に入り・ブースト・スタンプ・フォローは受け付けない。
    フォローしている相手の投稿など自分宛てでないものも、タイムラインと通知に出さない
    """
    blockedServers: [String!]! @lazy
    """
    ブロックしている他のサーバーのアカウント。新しくブロックした順。
    ブロックしたアカウントから自分宛てに届く投稿・お気に入り・ブースト・スタンプ・フォローは受け付けない。
    フォローしている相手がブーストしたものなど自分宛てでないものも、タイムラインと通知に出さない
    """
    blockedAccounts: [BlockedAccount!]! @lazy
}

type RemoteProfileRefreshState {
    "一度も始めていなければ null"
    progress: RemoteProfileRefreshProgress
}

type RemoteProfileRefreshProgress {
    running: Boolean!
    "始めたときに保存していた他のサーバーのユーザーの数"
    total: Int!
    refreshed: Int!
    "取りに行ったが取れなかった数"
    failed: Int!
    "相手のサーバーが続けて失敗したので取りに行かなかった数"
    skipped: Int!
    startedAt: String!
    "終わっていなければ null"
    finishedAt: String
}

type FailedDeliveryPage {
    deliveries: [FailedDelivery!]!
    nextCursor: String
}

"送るのを諦めた配信。送る本文は諦めたときに消すので持たない"
type FailedDelivery {
    id: FailedDeliveryId!
    "配信の種別。accept_follow / create_note / like など、サーバーの配信キューの綴りのまま"
    kind: String!
    "署名したこのサーバーのアカウント"
    username: String!
    inbox: String!
    "送ろうとした回数"
    attempts: Int!
    enqueuedAt: String!
    "諦めた時刻を残すようにする前に諦めたものは null"
    failedAt: String
    "最後に送れなかった理由"
    lastError: String
}

"フォローを仕分けるグループ。どのグループにも入れていないフォローはメインに入る"
type FollowingGroup {
    id: FollowingGroupId!
    name: String!
}

"ブロックしている他のサーバーのアカウント"
type BlockedAccount {
    actorUri: String!
    "ブロックしたときの username@host"
    acct: String!
}

"投稿のリプライ・いいね・ブーストの数。それぞれ TimelinePost の同じ名前の項目と同じ意味"
type PostCounts {
    replyCount: Int!
    favouriteCount: Int
    boostCount: Int
}
