schema {
    query: Query
    mutation: Mutation
    subscription: Subscription
}

type Query {
    "GraphQL は query にフィールドが 1 つ要る。空実装"
    unused: Boolean
    "有効なセッションの Cookie が無ければ null"
    userInfo: UserInfo
    user(username: String!): User
    "投稿は相手のサーバーの outbox を待つことがあるので含めない。userProfilePosts で別に読む"
    userProfile(acct: String!): UserProfile
    """
    プロフィールの投稿。after が null なら最初のページ、続きは前回の nextCursor を after に渡す。
    after を渡したときは、after が指す相手の続きを返す。
    見つからないか、他のサーバーのユーザーでログインしていなければ null
    """
    userProfilePosts(acct: String!, after: String): ProfilePostPage
    """
    名前の一部で、このサーバーのユーザーとフォローなどで受け取った他のサーバーのユーザーをまとめて探す。
    after には前回の nextCursor を渡す
    """
    searchUsers(query: String!, after: String): UserSearchResult!
    """
    `@user@host` か URL から 1 人を引く。このサーバーのユーザーも同じ書き方で引ける。
    他のサーバーへの問い合わせはログイン中に限る。見つからなければ null
    """
    resolveUser(query: String!): SearchedUser
    """
    ログイン中のアカウントがフォローしている相手を、フォローした新しい順に返す。ログインしていなければ null。
    after には前回の nextCursor を渡す
    """
    followingUsers(after: String): ActorList
    """
    ログイン中のアカウントのフォロワーを、フォローが成立した新しい順に返す。ログインしていなければ null。
    after には前回の nextCursor を渡す
    """
    followerUsers(after: String): ActorList
    "ログイン中のアカウントのパスキー。ログインしていなければ null"
    passkeys: [RegisteredPasskey!] @lazy
    "ログイン中のアカウントにパスワードがあるか。ログインしていなければ null"
    hasPassword: Boolean @lazy
    "ログイン中のアカウントのプロフィール。ログインしていなければ null"
    profile: Profile @lazy
}

type Profile {
    username: String!
    "未設定なら null"
    displayName: String
    "プロフィール画像の URL。未設定なら null"
    iconUrl: String
    "プロフィールの説明文。プレーンテキスト。未設定なら null"
    summary: String
    "プロフィールのリンク集。並べた順"
    links: [ProfileLink!]!
    followingCount: Int!
    "成立したフォローだけを数える"
    followersCount: Int!
}

type RegisteredPasskey {
    id: PasskeyCredentialId!
    name: String!
}

type Mutation {
    user: UserMutation!
}

type Subscription {
    """
    ログイン中のアカウントに起きた変化を、起きた順に流す。購読より前の変化は流さない。
    詰まると古いものから捨てるので、取りこぼしたら UserInfo.timeline と UserInfo.notifications で読み直す。ログインしていなければエラー
    """
    accountEvents: AccountEvent!
    """
    他のサーバーのユーザー全員のプロフィールを相手のサーバーから取り直す処理の進み具合。
    購読した時点の状態を流し、その後は変わるたびに流す。購読を切っても取り直しは止まらない。
    start が true なら、走っていなければ取り直しを始める。既に走っていれば、それの進み具合を流す。
    管理者でないか、サーバーに DOMAIN が無ければエラー
    """
    remoteProfileRefresh(start: Boolean!): RemoteProfileRefreshState!
}

"項目のうち、null でないものが必ず 1 つだけある。どれも id で上書きすればよく、何度当てても同じ結果になる"
type AccountEvent {
    "タイムラインに新しく載った行。どの購読先かは followingGroupId で分かる"
    timelinePostArrived: TimelinePost
    "消された行。投稿の削除とブーストの取り消しの両方"
    timelinePostsDeleted: TimelinePostsDeleted
    "自分の投稿に届いたお気に入りかブースト"
    notificationArrived: Notification
}

type TimelinePostsDeleted {
    "投稿者が投稿を消した行。元の投稿が消されたら、それをブーストした行の id もまとめて入れる"
    postIds: [TimelinePostId!]!
    "ブーストした相手がブーストを取り消した行"
    boostUndonePostIds: [TimelinePostId!]!
}

type TimelinePage {
    posts: [TimelinePost!]!
    nextCursor: String
}

type TimelinePost {
    id: TimelinePostId!
    "投稿者が投稿を消したら true。ほかの項目は消される前のまま返す"
    deleted: Boolean!
    "ブーストした相手がブーストを取り消したら true。ほかの項目は取り消される前のまま返す"
    boostUndone: Boolean!
    "タイムラインに並べる時刻。新しい順に並ぶ。複数の購読先を 1 つのカラムに混ぜるときに使う"
    sortedAt: String!
    content: String!
    publishedAt: String!
    author: Actor!
    summary: String
    sensitive: Boolean!
    "本文にあるカードにするリンク。本文に出てくる順で、UserInfo.linkPreviews と同じ並び。取りに行かないので速い"
    linkUrls: [String!]!
    "投稿に付いた画像。付いた順"
    images: [PostImage!]!
    "本文と summary に入るカスタム絵文字。画像を中継できなければ空"
    emojis: [CustomEmoji!]!
    "ログイン中のアカウントの投稿なら deleteNote に渡す id。消せない投稿は null"
    deletableNoteId: ID
    "ログイン中のアカウントの投稿なら setPinned に渡す id。固定できない投稿は null"
    pinnableNoteId: PublicNoteId
    "プロフィールの先頭に固定されているか。他のサーバーの投稿は false"
    pinned: Boolean! @lazy
    "他のサーバーから届いたお気に入りと、このサーバーのアカウントのいいねを合わせた数。他のサーバーの投稿は数を受け取らないので null"
    favouriteCount: Int
    "他のサーバーから届いたスタンプ。多く押された順。他のサーバーの投稿は受け取らないので空"
    stamps: [PostStamp!]!
    "共有するときに渡す投稿の URL。作れなければ null"
    url: String
    "ログイン中のアカウントがいいねしているか。ブーストで載った投稿は、ブーストされた元の投稿へのいいね"
    likedByMe: Boolean!
    "ログイン中のアカウントがブーストしているか。フォロワー限定などブーストできない投稿は null。ブーストで載った投稿は、ブーストされた元の投稿のブースト"
    boostedByMe: Boolean
    "setLiked と setBoosted に渡す id。ブーストで載った投稿は、ブーストされた元の投稿を指す"
    reactionPostId: TimelinePostId!
    "他のサーバーから届いたブーストの数。他のサーバーの投稿は数を受け取らないので null"
    boostCount: Int
    "フォローしている相手か自分のブーストとして載った投稿なら、ブーストした相手。author などほかの項目はブーストされた投稿のもの"
    boostedBy: Actor
    "投稿が載った購読先のグループ。ブーストならブーストした相手の購読先。メインなら null"
    followingGroupId: FollowingGroupId @lazy
}

"投稿者、ブーストした相手、通知を送ってきた相手"
type Actor {
    "他のサーバーのアクターの URI。このサーバーのアカウントなら null"
    actorUri: String
    username: String!
    "このサーバーのアカウントなら null"
    host: String
    displayName: String!
    "displayName に入るカスタム絵文字。画像を中継できなければ空"
    displayNameEmojis: [CustomEmoji!]!
    "プロフィール画像の URL。無ければ null"
    iconUrl: String
}

type NotificationPage {
    notifications: [Notification!]!
    nextCursor: String
}

type Notification {
    id: NotificationId!
    kind: NotificationKind!
    actor: Actor!
    "お気に入りかブーストをされた、自分の投稿"
    post: TimelinePost!
    receivedAt: String!
}

enum NotificationKind {
    FAVOURITE
    BOOST
}

"他のサーバーのカスタム絵文字。文字列の中の name を imageUrl の画像に置き換えて見せる"
type CustomEmoji {
    ":name: の形"
    name: String!
    imageUrl: String!
}

type PostStamp {
    "絵文字そのもの、またはカスタム絵文字の :name:"
    emoji: String!
    "カスタム絵文字の画像の URL。Unicode の絵文字か、画像を中継できなければ null"
    imageUrl: String
    count: Int!
}

type PostImage {
    url: String!
    "元の画像 URL に type=thumbnail を付けたサムネイル用 URL"
    thumbnailUrl: String!
    "画像の説明文。無ければ null"
    description: String
}

"投稿の本文にあるリンク先の OGP。取れなかった項目は null"
type LinkPreview {
    url: String!
    title: String
    siteName: String
    imageUrl: String
    "リンク先のサイトのアイコン。imageUrl が無いときにカードに出す"
    faviconUrl: String
}
