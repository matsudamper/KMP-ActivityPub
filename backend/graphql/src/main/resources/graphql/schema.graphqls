schema {
    query: Query
    mutation: Mutation
}

type Query {
    "GraphQL は query にフィールドが 1 つ要る。空実装"
    unused: Boolean
    "有効なセッションの Cookie が無ければ null"
    userInfo: UserInfo
    user(username: String!): User
    userProfile(acct: String!): UserProfile
    """
    名前の一部で、このサーバーのユーザーとフォローなどで受け取った他のサーバーのユーザーをまとめて探す。
    after には前回の nextCursor を渡す
    """
    searchUsers(query: String!, after: String): UserSearchResult!
    """
    `@user@host` か URL から 1 人を引く。このサーバーのユーザーも同じ書き方で引ける。
    他のサーバーへの問い合わせはログイン中に限る。見つからなければ null
    """
    resolveUser(query: String!): SearchedUser
    """
    ログイン中のアカウントがフォローしている相手を、フォローした新しい順に返す。ログインしていなければ null。
    after には前回の nextCursor を渡す
    """
    followingUsers(after: String): ActorList
    """
    ログイン中のアカウントのフォロワーを、フォローが成立した新しい順に返す。ログインしていなければ null。
    after には前回の nextCursor を渡す
    """
    followerUsers(after: String): ActorList
    "ログイン中のアカウントのパスキー。ログインしていなければ null"
    passkeys: [RegisteredPasskey!] @lazy
    "ログイン中のアカウントにパスワードがあるか。ログインしていなければ null"
    hasPassword: Boolean @lazy
    "ログイン中のアカウントのプロフィール。ログインしていなければ null"
    profile: Profile @lazy
}

type Profile {
    username: String!
    "未設定なら null"
    displayName: String
    "プロフィール画像の URL。未設定なら null"
    iconUrl: String
    followingCount: Int!
    "成立したフォローだけを数える"
    followersCount: Int!
}

type RegisteredPasskey {
    id: PasskeyCredentialId!
    name: String!
}

type Mutation {
    user: UserMutation!
}

type HomeTimeline {
    posts: [HomeTimelinePost!]!
    nextCursor: String
}

type HomeTimelinePost {
    content: String!
    publishedAt: String!
    username: String!
    host: String
    displayName: String!
    summary: String
    sensitive: Boolean!
}
