"外から見えるユーザーの情報"
type User {
    username: String!
}

type UserSearchResult {
    users: [SearchedUser!]!
    "続きが無ければ null"
    nextCursor: String
}

"検索で見つかったユーザー"
type SearchedUser {
    username: String!
    "このサーバーのユーザーなら null"
    host: String
    "このサーバーのユーザーはまだ表示名を持たないので null"
    displayName: String
}
