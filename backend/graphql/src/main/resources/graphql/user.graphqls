"外から見えるユーザーの情報"
type User {
    username: String!
    "プロフィール画像の URL。未設定なら null"
    iconUrl: String
}

type UserProfile {
    user: SearchedUser!
    "ヘッダー画像の URL。未設定か、このサーバーのユーザーなら null"
    headerUrl: String
    "プロフィールの説明文。プレーンテキスト"
    biography: String
    "プロフィールのリンク集。並べた順。他のサーバーのユーザーのものは受け取っていないので空"
    links: [ProfileLink!]!
    "ログイン中のアカウント本人のプロフィールか"
    viewerIsOwner: Boolean!
}

type ProfilePostPage {
    posts: [ProfilePost!]!
    "続きが無ければ null"
    nextCursor: String
}

type ProfileLink {
    name: String!
    url: String!
}

type ProfilePost {
    content: String!
    publishedAt: String!
    summary: String
    sensitive: Boolean!
    "UserInfo.timelinePost で個別投稿画面を開くときと、UserInfo.linkPreviews で OGP を取るときの id。保存していない他のサーバーの投稿は、個別投稿画面を開くときに保存する"
    id: TimelinePostId!
    "ログイン中のアカウントの投稿なら deleteNote に渡す id。消せない投稿は null"
    deletableNoteId: PublicNoteId
    "プロフィールの先頭に固定されているか。固定した投稿は posts の先頭に固定した新しい順で並ぶ。他のサーバーの投稿は固定を受け取らないので false"
    pinned: Boolean!
    "ログイン中のアカウントのプロフィールの投稿なら setPinned に渡す id。固定できない投稿は null"
    pinnableNoteId: PublicNoteId
    "本文にあるカードにするリンク。本文に出てくる順で、UserInfo.linkPreviews と同じ並び"
    linkUrls: [String!]!
    "本文にあるメンション。本文に出てくる順"
    mentions: [PostMention!]!
    "投稿に付いた画像。付いた順"
    images: [PostImage!]!
    "本文と summary に入るカスタム絵文字。画像を中継できなければ空"
    emojis: [CustomEmoji!]!
    "他のサーバーから届いたお気に入りと、このサーバーのアカウントのいいねを合わせた数。他のサーバーの投稿は数を受け取らないので null"
    favouriteCount: Int
    "他のサーバーから届いたスタンプ。多く押された順。他のサーバーの投稿は受け取らないので空"
    stamps: [PostStamp!]!
    "共有するときに渡す投稿の URL。作れなければ null"
    url: String
    "他のサーバーから届いたブーストの数。他のサーバーの投稿は数を受け取らないので null"
    boostCount: Int
    "ログイン中のアカウントがいいねしているか。ログインしていないか、いいねできない投稿は null。付け外しは UserMutation.setLiked に reactionPostId を渡す"
    likedByMe: Boolean
    "ログイン中のアカウントがブーストしているか。ログインしていないか、ブーストできない投稿は null。付け外しは UserMutation.setBoosted に reactionPostId を渡す"
    boostedByMe: Boolean
    """
    setLiked と setBoosted に渡す id。本人がブーストした投稿は、ブーストされた元の投稿を指す。ログインしていないか、付け外しできない投稿は null。
    他のサーバーの投稿は表示のたびに相手のサーバーから取り、保存はしない。保存していない投稿の id は、いいねやブーストを付けたときに投稿を取ってきて保存する
    """
    reactionPostId: TimelinePostId
    "プロフィールの本人がブーストした投稿なら、その投稿者。本人の投稿は null"
    boostedNoteAuthor: PostAuthor
}

type PostAuthor {
    username: String!
    host: String!
    displayName: String!
    "displayName に入るカスタム絵文字。画像を中継できなければ空"
    displayNameEmojis: [CustomEmoji!]!
    "プロフィール画像の URL。無ければ null"
    iconUrl: String
}

type UserSearchResult {
    users: [SearchedUser!]!
    "続きが無ければ null"
    nextCursor: String
}

"検索で見つかったユーザー"
type SearchedUser {
    actorUri: String
    "このサーバー内部でのフォロー状態"
    following: Boolean! @lazy
    "フォローを入れたグループ。フォローしていないか、メインに入っていれば null"
    followingGroupId: FollowingGroupId @lazy
    username: String!
    host: String!
    "このサーバーのユーザーか"
    isLocal: Boolean!
    "表示名が無ければユーザー名"
    displayName: String!
    "displayName に入るカスタム絵文字。画像を中継できなければ空"
    displayNameEmojis: [CustomEmoji!]!
    iconUrl: String
}

type ActorList {
    users: [ListedActor!]!
    "続きが無ければ null"
    nextCursor: String
}

"""
フォロー・フォロワーの一覧の 1 人。フォローした相手のプロフィールは、こちらをフォローしてきたときにしか受け取らないので、
受け取っていなければ username や displayName が null になる
"""
type ListedActor {
    actorUri: String!
    "ログイン中のアカウントがフォローしているか"
    following: Boolean! @lazy
    "フォローを入れたグループ。フォローしていないか、メインに入っていれば null"
    followingGroupId: FollowingGroupId @lazy
    username: String
    host: String!
    displayName: String
    "displayName に入るカスタム絵文字。画像を中継できなければ空"
    displayNameEmojis: [CustomEmoji!]!
    iconUrl: String
}
