type UserInfo {
    """
    購読先 1 つの行を新しい順に返す。followingGroupId が null ならメイン（グループに入れていないフォローと自分の投稿）。
    after には前回の nextCursor を渡す。消された投稿も deleted を立てて返す
    """
    timeline(followingGroupId: FollowingGroupId, after: String, limit: Int!): TimelinePage @lazy
    "自分の投稿に届いたお気に入りとブーストを新しい順に返す。after には前回の nextCursor を渡す"
    notifications(after: String, limit: Int!): NotificationPage @lazy
    """
    投稿の本文にあるリンク先の OGP。postId には TimelinePost.id か ProfilePost.linkPreviewId を渡す。
    リンク先へ取りに行くので遅い。読めない投稿か、サーバーに DOMAIN が無ければ空
    """
    linkPreviews(postId: LinkPreviewPostId!): [LinkPreview!]! @lazy
    "タイムラインの投稿を 1 件。id には TimelinePost.id を渡す。読めない投稿なら null"
    timelinePost(id: TimelinePostId!): TimelinePost @lazy
    id: UserId!
    "サーバーの ADMIN_USER_IDS に入っていれば true。管理画面に入れる"
    isAdmin: Boolean!
    "フォローを仕分けるグループ。作った順"
    followingGroups: [FollowingGroup!]! @lazy
    "どのグループにも入れていないフォローを入れるメインの名前"
    mainGroupName: String! @lazy
    "ブロックしている他のサーバーのホスト。新しくブロックした順。ブロックしたサーバーのアクターの投稿・ブースト・通知はタイムラインと通知に出さない"
    blockedServers: [String!]! @lazy
}

type RemoteProfileRefreshState {
    "一度も始めていなければ null"
    progress: RemoteProfileRefreshProgress
}

type RemoteProfileRefreshProgress {
    running: Boolean!
    "始めたときに保存していた他のサーバーのユーザーの数"
    total: Int!
    refreshed: Int!
    "取りに行ったが取れなかった数"
    failed: Int!
    "相手のサーバーが続けて失敗したので取りに行かなかった数"
    skipped: Int!
    startedAt: String!
    "終わっていなければ null"
    finishedAt: String
}

"フォローを仕分けるグループ。どのグループにも入れていないフォローはメインに入る"
type FollowingGroup {
    id: FollowingGroupId!
    name: String!
}
