type UserMutation {
    """
    内部のフォロー状態を設定する。未ログインや不正な相手なら false。
    フォローするときは groupId のグループに入れる。null ならメイン。既にフォローしていればグループだけ入れ直す。
    groupId がログイン中のアカウントのグループでなければ false
    """
    setFollowing(actorUri: String!, followed: Boolean!, groupId: FollowingGroupId): Boolean! @lazy
    "フォローを仕分けるグループを作る。同じ名前のグループが既にあればそれを返す"
    createFollowingGroup(name: String!): CreateFollowingGroupResult! @lazy
    "フォローを仕分けるグループの名前を変える。groupId が null ならメインの名前を変える"
    renameFollowingGroup(groupId: FollowingGroupId, name: String!): RenameFollowingGroupResult! @lazy
    login(query: UserLoginQuery!): UserLoginResult! @lazy
    passkeyLoginOptions: String! @lazy
    passkeyLogin(credential: String!): UserPasskeyLoginResult! @lazy
    "ログインしていなければ null"
    passkeyRegistrationOptions: String @lazy
    registerPasskey(query: RegisterPasskeyQuery!): RegisterPasskeyResult! @lazy
    deletePasskey(id: PasskeyCredentialId!): DeletePasskeyResult! @lazy
    "パスワードが既に無くても成功する"
    deletePassword: DeletePasswordResult! @lazy
    "セッションが無くても成功する"
    logout: Boolean! @lazy
    """
    ログインしているアカウントで投稿し、フォロワーへの配信を積む。同じ requestId で送り直すと最初の投稿を返す。
    imageIds には uploadNoteImage で置いた画像を付ける順に渡す。省略すると画像無し。画像があれば本文は空でもよい
    """
    postNote(body: String!, requestId: String!, imageIds: [NoteImageId!]! = []): UserPostNoteResult! @lazy
    """
    投稿に付ける画像を置く。multipart で送る。PNG / JPEG / GIF / WebP で 20MB まで。
    description は画像の説明文で 1500 文字まで。置いてから 1 時間のうちに postNote で付けなければ消える
    """
    uploadNoteImage(image: Upload!, description: String): UploadNoteImageResult! @lazy
    """
    ログインしているアカウントの投稿を消し、フォロワーへの Delete を積む。付けた画像も消す。
    noteId には TimelinePost.deletableNoteId を渡す
    """
    deleteNote(noteId: PublicNoteId!): DeleteNoteResult! @lazy
    "ログインしているアカウントのプロフィールを書き換え、フォロワーへの Update を積む。null の項目は今のまま"
    updateProfile(query: UpdateProfileQuery!): UpdateProfileResult! @lazy
    """
    ログインしているアカウントのプロフィール画像を差し替え、フォロワーへの Update を積む。
    icon は画像を base64 にしたもの。PNG / JPEG / GIF / WebP で 2MiB まで、縦横 400px まで
    """
    updateProfileIcon(icon: String!): UpdateProfileIconResult! @lazy
    """
    ログインしているアカウントで、投稿にいいねを付けるか外す。他のサーバーの投稿なら投稿者への Like か Undo を積む。
    postId は TimelinePost.reactionPostId か ProfilePost.reactionPostId。既に望んだ状態なら何も積まずに成功する。
    外すときは今読めない投稿でも、付けたいいねを外す
    """
    setLiked(postId: TimelinePostId!, liked: Boolean!): SetLikedResult! @lazy
    """
    ログインしているアカウントで、このサーバーの投稿か、他のサーバーの公開の投稿をブーストするか外す。公開範囲に制限のある投稿はブーストできない。フォロワーと投稿者への Announce か Undo を積む。
    postId は TimelinePost.reactionPostId か ProfilePost.reactionPostId。既に望んだ状態なら何も積まずに成功する。
    外すときは今読めない投稿でも、付けたブーストを外す
    """
    setBoosted(postId: TimelinePostId!, boosted: Boolean!): SetBoostedResult! @lazy
    """
    ログインしているアカウントの投稿を、プロフィールの先頭に固定するか外す。他のサーバーには配らない。
    noteId は ProfilePost.pinnableNoteId。既に望んだ状態なら何もせずに成功する
    """
    setPinned(noteId: PublicNoteId!, pinned: Boolean!): SetPinnedResult! @lazy
}

type CreateFollowingGroupResult {
    "作れなければ null"
    group: FollowingGroup
    failure: CreateFollowingGroupFailure
}

enum CreateFollowingGroupFailure {
    NOT_LOGGED_IN
    "名前が空か長すぎる。上限は 30 文字"
    INVALID_NAME
}

type RenameFollowingGroupResult {
    "変えられたら null"
    failure: RenameFollowingGroupFailure
}

enum RenameFollowingGroupFailure {
    NOT_LOGGED_IN
    "名前が空か長すぎる。上限は 30 文字"
    INVALID_NAME
    "グループが無いか、ログイン中のアカウントのグループでない"
    NOT_FOUND
    "同じ名前のグループが既にある"
    DUPLICATE_NAME
}

input UserLoginQuery {
    username: String!
    password: String!
}

type UserLoginResult {
    failure: UserLoginFailure
}

enum UserLoginFailure {
    "ユーザーがいないか、パスワードが違う。"
    WRONG_USERNAME_OR_PASSWORD
}

type UserPasskeyLoginResult {
    failure: UserPasskeyLoginFailure
}

enum UserPasskeyLoginFailure {
    NOT_ACCEPTED
}

input RegisterPasskeyQuery {
    name: String!
    credential: String!
}

type RegisterPasskeyResult {
    failure: RegisterPasskeyFailure
}

enum RegisterPasskeyFailure {
    NOT_LOGGED_IN
    NOT_ACCEPTED
    ALREADY_REGISTERED
    INVALID_NAME
}

type DeletePasskeyResult {
    failure: DeletePasskeyFailure
}

enum DeletePasskeyFailure {
    NOT_LOGGED_IN
    "ログイン中のアカウントのパスキーではない"
    NOT_FOUND
    "パスワードが無く、最後のパスキーなので消すとログインできなくなる"
    LAST_LOGIN_METHOD
}

type DeletePasswordResult {
    failure: DeletePasswordFailure
}

enum DeletePasswordFailure {
    NOT_LOGGED_IN
    "パスキーが無いので消すとログインできなくなる"
    NO_PASSKEY
}

type UserPostNoteResult {
    "投稿の URL。投稿できなければ null"
    url: String
    failure: UserPostNoteFailure
}

enum UserPostNoteFailure {
    NOT_LOGGED_IN
    "本文も画像も無い"
    EMPTY_BODY
    "本文が長すぎる。上限は 500 文字"
    TOO_LONG
    "画像が多すぎる。上限は 4 枚"
    TOO_MANY_IMAGES
    "置いていないか、期限を過ぎたか、もう別の投稿に付けた画像がある"
    IMAGE_NOT_FOUND
    "サーバーに DOMAIN が無く、投稿を配れない"
    FEDERATION_DISABLED
}

input UpdateProfileQuery {
    "空なら未設定に戻す"
    displayName: String
    "プロフィールの説明文。プレーンテキスト。空なら未設定に戻す"
    summary: String
    "プロフィールのリンク集。並べる順に渡す。名前も URL も空の行は捨てる。空のリストなら消す"
    links: [ProfileLinkInput!]
}

input ProfileLinkInput {
    name: String!
    "http か https の URL"
    url: String!
}

type UpdateProfileResult {
    failure: UpdateProfileFailure
}

enum UpdateProfileFailure {
    NOT_LOGGED_IN
    "表示名が長すぎる。上限は 30 文字"
    TOO_LONG
    "説明文が長すぎる。上限は 500 文字"
    SUMMARY_TOO_LONG
    "リンクが多すぎる。上限は 4 件"
    TOO_MANY_LINKS
    "リンクの見出しか URL が長すぎる。上限はそれぞれ 255 文字"
    LINK_TOO_LONG
    "リンクの見出しが空か、URL が http / https ではない"
    INVALID_LINK
    "サーバーに DOMAIN が無く、更新を配れない"
    FEDERATION_DISABLED
}

type UpdateProfileIconResult {
    "差し替えた画像の URL。失敗したら null"
    iconUrl: String
    failure: UpdateProfileIconFailure
}

enum UpdateProfileIconFailure {
    NOT_LOGGED_IN
    "大きすぎる。上限は 2MiB"
    TOO_LARGE
    "縦か横が 400px を超えている"
    DIMENSIONS_TOO_LARGE
    "base64 として読めないか、PNG / JPEG / GIF / WebP ではない"
    UNSUPPORTED_IMAGE
    "このサーバーでは受け付けない操作"
    UNSUPPORTED_OPERATION
    "サーバー内部の失敗。時間をおいて送り直せば通ることがある"
    INTERNAL_SERVER_ERROR
    "サーバーに DOMAIN が無く、更新を配れない"
    FEDERATION_DISABLED
}

type UploadNoteImageResult {
    "postNote の imageIds に渡す識別子。置けなければ null"
    imageId: NoteImageId
    failure: UploadNoteImageFailure
}

enum UploadNoteImageFailure {
    NOT_LOGGED_IN
    "大きすぎる。上限は 20MB"
    TOO_LARGE
    "PNG / JPEG / GIF / WebP ではない"
    UNSUPPORTED_IMAGE
    "画像の説明文が長すぎる。上限は 1500 文字"
    DESCRIPTION_TOO_LONG
    "このサーバーでは画像を置けない"
    UNSUPPORTED_OPERATION
    "サーバー内部の失敗。時間をおいて送り直せば通ることがある"
    INTERNAL_SERVER_ERROR
}

type SetLikedResult {
    failure: SetLikedFailure
}

enum SetLikedFailure {
    NOT_LOGGED_IN
    "無いか、読めない投稿"
    POST_NOT_FOUND
    "サーバーに DOMAIN が無く、いいねを配れない"
    FEDERATION_DISABLED
}

type SetBoostedResult {
    failure: SetBoostedFailure
}

enum SetBoostedFailure {
    NOT_LOGGED_IN
    "無いか、読めないか、ブーストできない投稿"
    POST_NOT_FOUND
    "サーバーに DOMAIN が無く、ブーストを配れない"
    FEDERATION_DISABLED
}

type DeleteNoteResult {
    failure: DeleteNoteFailure
}

enum DeleteNoteFailure {
    NOT_LOGGED_IN
    "無いか、ログイン中のアカウントの投稿ではない"
    NOT_FOUND
    "サーバーに DOMAIN が無く、削除を配れない"
    FEDERATION_DISABLED
    "サーバー内部の失敗。投稿は残っているので、時間をおいて送り直せば通ることがある"
    INTERNAL_SERVER_ERROR
}

type SetPinnedResult {
    failure: SetPinnedFailure
}

enum SetPinnedFailure {
    NOT_LOGGED_IN
    "無いか、ログイン中のアカウントの投稿ではない"
    NOT_FOUND
    "固定している投稿が多すぎる。上限は 5 件"
    TOO_MANY_PINS
}
