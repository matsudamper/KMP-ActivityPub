type UserMutation {
    login(query: UserLoginQuery!): UserLoginResult! @lazy
    passkeyLoginOptions: PasskeyLoginOptions! @lazy
    passkeyLogin(query: UserPasskeyLoginQuery!): UserPasskeyLoginResult! @lazy
    "ログイン中のアカウントにパスキーを足すための値を発行する。ログインしていなければ null"
    passkeyRegistrationOptions: PasskeyRegistrationOptions @lazy
    registerPasskey(query: RegisterPasskeyQuery!): RegisterPasskeyResult! @lazy
    deletePasskey(id: PasskeyCredentialId!): DeletePasskeyResult! @lazy
}

input UserLoginQuery {
    username: String!
    password: String!
}

type UserLoginResult {
    failure: UserLoginFailure
}

enum UserLoginFailure {
    "ユーザーがいないか、パスワードが違う。"
    WRONG_USERNAME_OR_PASSWORD
}

"バイト列はすべて base64url（パディング無し）"
type PasskeyLoginOptions {
    challenge: String!
    rpId: String!
}

"バイト列はすべて base64url（パディング無し）"
type PasskeyRegistrationOptions {
    challenge: String!
    rpId: String!
    userHandle: PasskeyUserHandle!
    username: String!
    "COSE Algorithms の値"
    algorithms: [Int!]!
    excludeCredentialIds: [PasskeyCredentialId!]!
}

"バイト列はすべて base64url（パディング無し）。WebAuthn の AuthenticatorAssertionResponse の値をそのまま渡す"
input UserPasskeyLoginQuery {
    credentialId: PasskeyCredentialId!
    clientDataJson: String!
    authenticatorData: String!
    signature: String!
    userHandle: PasskeyUserHandle
}

type UserPasskeyLoginResult {
    failure: UserPasskeyLoginFailure
}

enum UserPasskeyLoginFailure {
    NOT_ACCEPTED
}

"バイト列はすべて base64url（パディング無し）。WebAuthn の AuthenticatorAttestationResponse の値をそのまま渡す"
input RegisterPasskeyQuery {
    name: String!
    clientDataJson: String!
    attestationObject: String!
}

type RegisterPasskeyResult {
    failure: RegisterPasskeyFailure
}

enum RegisterPasskeyFailure {
    NOT_LOGGED_IN
    NOT_ACCEPTED
    ALREADY_REGISTERED
    INVALID_NAME
}

type DeletePasskeyResult {
    failure: DeletePasskeyFailure
}

enum DeletePasskeyFailure {
    NOT_LOGGED_IN
    "ログイン中のアカウントのパスキーではない"
    NOT_FOUND
}
