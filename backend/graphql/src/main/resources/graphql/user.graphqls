"外から見えるユーザーの情報"
type User {
    username: String!
    "プロフィール画像の URL。未設定なら null"
    iconUrl: String
}

type UserSearchResult {
    users: [SearchedUser!]!
    "続きが無ければ null"
    nextCursor: String
}

"検索で見つかったユーザー"
type SearchedUser {
    actorUri: String
    "このサーバー内部でのフォロー状態"
    following: Boolean!
    username: String!
    host: String!
    "このサーバーのユーザーか"
    isLocal: Boolean!
    "表示名が無ければユーザー名"
    displayName: String!
    iconUrl: String
}

type FollowingUserList {
    users: [FollowingUser!]!
    "続きが無ければ null"
    nextCursor: String
}

"""
フォローしている相手。相手のプロフィールはこちらをフォローしてきたときに受け取ったものしか無いので、
受け取っていなければ username や displayName が null になる
"""
type FollowingUser {
    actorUri: String!
    username: String
    host: String!
    displayName: String
    iconUrl: String
}
