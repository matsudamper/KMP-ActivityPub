schema {
    query: Query
    mutation: Mutation
    subscription: Subscription
}

type Query {
    "GraphQL は query にフィールドが 1 つ要る。空実装"
    unused: Boolean
    "有効なセッションの Cookie が無ければ null"
    userInfo: UserInfo
    user(username: String!): User
    """
    個別投稿画面に出す投稿を 1 件。id には TimelinePost.id か ProfilePost.id を渡す。
    タイムラインに載る投稿に加えて、プロフィールに並ぶ投稿も開ける。保存していない他のサーバーの投稿は取ってきて保存する。開けない投稿なら null。
    ログインしていなければ、他のサーバーの投稿は保存済みで公開のものだけ開ける
    """
    timelinePost(id: TimelinePostId!): TimelinePost
    """
    postId の投稿の返信先。postId には TimelinePost.id を渡す。返した投稿の id を渡せば、さらに返信先をたどれる。
    保存していない他のサーバーの投稿は、相手のサーバーから取って保存せずに返すので遅い。その id と reactionPostId は保存していない投稿を指し、いいねやブーストを付けたときに保存する。
    返信でないか、返信先を読めないか、サーバーに DOMAIN が無ければ null。返信先のサーバーが応えなければ、null とエラーを返す。
    ログインしていなければ、相手のサーバーへは取りに行かない
    """
    replyTarget(postId: TimelinePostId!): TimelinePost
    """
    postId の投稿の引用先。postId には TimelinePost.id を渡す。読み方と返す投稿は replyTarget と同じ。
    引用でないか、引用先を読めないか、サーバーに DOMAIN が無ければ null。引用先のサーバーが応えなければ、null とエラーを返す。
    ログインしていなければ、相手のサーバーへは取りに行かない
    """
    quoteTarget(postId: TimelinePostId!): TimelinePost
    """
    投稿のリプライ・いいね・ブーストの数。id には TimelinePost.id か ProfilePost.id を渡す。開けない投稿なら null。
    他のサーバーの投稿は、前に取ってから 1 分経っていれば相手のサーバーから数を取り直すので遅い。個別投稿画面を開いたときに使う
    """
    postCounts(postId: TimelinePostId!): PostCounts
    """
    postId の投稿への返信を古い順に 100 件まで。postId には TimelinePost.id を渡す。ブーストで載った投稿は、ブーストされた元の投稿への返信。
    このサーバーが保存している投稿だけを返し、相手のサーバーへは取りに行かない。消された返信とブロックした相手の返信は入らない。
    読めない投稿か、サーバーに DOMAIN が無ければ空
    """
    replies(postId: TimelinePostId!): [TimelinePost!]!
    """
    投稿の本文にあるリンク先の OGP。postId には TimelinePost.id か ProfilePost.id を渡す。
    リンク先へ取りに行くので遅い。読めない投稿か、保存していない他のサーバーの投稿か、サーバーに DOMAIN が無ければ空
    """
    linkPreviews(postId: TimelinePostId!): [LinkPreview!]!
    """
    投稿は相手のサーバーの outbox を待つことがあるので含めない。userProfilePosts で別に読む。
    ログインしていなければ、他のサーバーのユーザーは相手のサーバーへ取りに行かず、このサーバーが保存しているユーザーだけを返す
    """
    userProfile(acct: String!): UserProfile
    """
    プロフィールの投稿。after が null なら最初のページ、続きは前回の nextCursor を after に渡す。
    after を渡したときは、after が指す相手の続きを返す。
    ログインしていなければ、他のサーバーのユーザーは相手のサーバーへ取りに行かず、保存済みの公開と公開タイムラインに載せない公開の投稿と、それらのブーストだけを返す。
    見つからなければ null
    """
    userProfilePosts(acct: String!, after: String): ProfilePostPage
    """
    プロフィールのユーザーがいいねした投稿。after が null なら最初のページ、続きは前回の nextCursor を after に渡す。
    このサーバーのユーザーは本人か、いいねを公開しているとき、他のサーバーのユーザーは Actor の liked を読めたときに返す。
    見ているアカウントが開けない投稿は出さない。返せないか、ログインしていなければ null で、プロフィールに「いいね」を出さない
    """
    userProfileLikes(acct: String!, after: String): ProfileLikePage
    """
    名前の一部で、このサーバーのユーザーとフォローなどで受け取った他のサーバーのユーザーをまとめて探す。
    after には前回の nextCursor を渡す
    """
    searchUsers(query: String!, after: String): UserSearchResult!
    """
    本文の一部で、このサーバーが保存している投稿を、投稿した新しい順に探す。空白で区切ると、すべてを本文に含む投稿を探す。
    このサーバーの投稿と、他のサーバーの投稿のうちログイン中のアカウントが読めるものと公開のものから探す。
    after には前回の nextCursor を渡す。ログインしていなければ null
    """
    searchPosts(query: String!, after: String): PostSearchResult
    """
    `@user@host` か URL から 1 人を引く。このサーバーのユーザーも同じ書き方で引ける。
    他のサーバーへの問い合わせはログイン中に限る。見つからなければ null
    """
    resolveUser(query: String!): SearchedUser
    """
    ログイン中のアカウントがフォローしている相手を、フォローした新しい順に返す。ログインしていなければ null。
    after には前回の nextCursor を渡す
    """
    followingUsers(after: String): ActorList
    """
    ログイン中のアカウントのフォロワーを、フォローが成立した新しい順に返す。ログインしていなければ null。
    after には前回の nextCursor を渡す
    """
    followerUsers(after: String): ActorList
    "ログイン中のアカウントのパスキー。ログインしていなければ null"
    passkeys: [RegisteredPasskey!] @lazy
    "ログイン中のアカウントにパスワードがあるか。ログインしていなければ null"
    hasPassword: Boolean @lazy
    "ログイン中のアカウントのプロフィール。ログインしていなければ null"
    profile: Profile @lazy
    "このサーバーで置いたカスタム絵文字。shortcode の順。ログインしていないか、置けないサーバーなら null"
    customEmojis: [LocalCustomEmoji!] @lazy
}

"このサーバーで置いたカスタム絵文字。サーバーの全員が使える"
type LocalCustomEmoji {
    id: CustomEmojiId!
    "本文やリアクションに :shortcode: で入る名前。コロンは含まない"
    shortcode: String!
    imageUrl: String!
    "ログイン中のアカウントが置いた絵文字か。消せるのは置いたアカウントだけ"
    deletable: Boolean!
}

"ログイン中のアカウントが投稿に付けたリアクション"
type ViewerReaction {
    "絵文字そのもの、またはカスタム絵文字の :shortcode:"
    emoji: String!
    "カスタム絵文字の画像の URL。Unicode の絵文字か、消された絵文字なら null"
    imageUrl: String
}

type Profile {
    username: String!
    "未設定なら null"
    displayName: String
    "プロフィール画像の URL。未設定なら null"
    iconUrl: String
    "プロフィールヘッダーの URL。未設定なら null"
    headerUrl: String
    "プロフィールの説明文。プレーンテキスト。未設定なら null"
    summary: String
    "プロフィールのリンク集。並べた順"
    links: [ProfileLink!]!
    "いいねした投稿の一覧を、プロフィールと他のサーバーに公開しているか"
    likesPublic: Boolean!
    followingCount: Int!
    "成立したフォローだけを数える"
    followersCount: Int!
}

type RegisteredPasskey {
    id: PasskeyCredentialId!
    name: String!
}

type Mutation {
    user: UserMutation!
}

type Subscription {
    """
    ログイン中のアカウントに起きた変化を、起きた順に流す。購読より前の変化は流さない。
    詰まると古いものから捨てるので、取りこぼしたら UserInfo.timeline と UserInfo.notifications で読み直す。ログインしていなければエラー
    """
    accountEvents: AccountEvent!
    """
    他のサーバーのユーザー全員のプロフィールを相手のサーバーから取り直す処理の進み具合。
    購読した時点の状態を流し、その後は変わるたびに流す。購読を切っても取り直しは止まらない。
    start が true なら、走っていなければ取り直しを始める。既に走っていれば、それの進み具合を流す。
    管理者でないか、サーバーに DOMAIN が無ければエラー
    """
    remoteProfileRefresh(start: Boolean!): RemoteProfileRefreshState!
}

"項目のうち、null でないものが必ず 1 つだけある。どれも id で上書きすればよく、何度当てても同じ結果になる"
type AccountEvent {
    "タイムラインに新しく載った行。どの購読先かは followingGroupId で分かる"
    timelinePostArrived: TimelinePost
    "消された行。投稿の削除とブーストの取り消しの両方"
    timelinePostsDeleted: TimelinePostsDeleted
    "通知カラムの項目に相手が加わったか、お気に入りの絵文字が付け直された。id で置き換え、updatedAt が新しくなっていれば先頭へ移す"
    notificationGroupUpdated: NotificationGroup
    "既に載っている行の中身が変わった。投稿者による編集と、付いたリアクションの増減。載せていない行なら何もしなくてよい"
    timelinePostUpdated: TimelinePost
}

type TimelinePostsDeleted {
    "投稿者が投稿を消した行。元の投稿が消されたら、それをブーストした行の id もまとめて入れる"
    postIds: [TimelinePostId!]!
    "ブーストした相手がブーストを取り消した行"
    boostUndonePostIds: [TimelinePostId!]!
}

type TimelinePage {
    posts: [TimelinePost!]!
    nextCursor: String
}

type TimelinePost {
    id: TimelinePostId!
    "投稿者が投稿を消したら true。ほかの項目は消される前のまま返す"
    deleted: Boolean!
    "ブーストした相手がブーストを取り消したら true。ほかの項目は取り消される前のまま返す"
    boostUndone: Boolean!
    "タイムラインに並べる時刻。新しい順に並ぶ。複数の購読先を 1 つのカラムに混ぜるときに使う"
    sortedAt: String!
    content: String!
    "BCP 47 の言語タグ。このサーバーの投稿と、相手のサーバーが付けていない投稿は null"
    language: String
    publishedAt: String!
    author: Actor!
    summary: String
    sensitive: Boolean!
    "本文にあるカードにするリンク。本文に出てくる順で、Query.linkPreviews と同じ並び。取りに行かないので速い"
    linkUrls: [String!]!
    "Link で届いた投稿のリンク先。linkUrls のどれかと同じ URL。Link でない投稿と、カードにするリンクを返さない投稿は null"
    linkObjectUrl: String
    "投稿本体・添付・タグのうち、このサーバーが読み方を知らない ActivityPub の type の名前。このサーバーの投稿は空"
    unknownObjectTypes: [String!]!
    "本文にあるメンション。本文に出てくる順"
    mentions: [PostMention!]!
    "投稿に付いた画像。付いた順"
    images: [PostImage!]!
    "投稿に付いた動画。付いた順"
    videos: [PostVideo!]!
    "本文と summary に入るカスタム絵文字。画像を中継できなければ空"
    emojis: [CustomEmoji!]!
    "ログイン中のアカウントの投稿なら deleteNote に渡す id。消せない投稿は null"
    deletableNoteId: PublicNoteId
    "ログイン中のアカウントの投稿なら setPinned に渡す id。固定できない投稿は null"
    pinnableNoteId: PublicNoteId
    "プロフィールの先頭に固定されているか。他のサーバーの投稿は false"
    pinned: Boolean! @lazy
    "他のサーバーから届いたお気に入りと、このサーバーのアカウントのいいねを合わせた数。他のサーバーの投稿は、相手のサーバーが出している数を Query.postCounts で取ったことがあればその数で、無ければ null"
    favouriteCount: Int
    "他のサーバーから届いたスタンプと、このサーバーのアカウントのリアクション。先に押された絵文字の順。他のサーバーの投稿は受け取らないので空"
    stamps: [PostStamp!]!
    "共有するときに渡す投稿の URL。作れなければ null"
    url: String
    "ログイン中のアカウントがいいねしているか。リアクションも Like で送るので、リアクションを付けていても true。ブーストで載った投稿は、ブーストされた元の投稿へのいいね"
    likedByMe: Boolean!
    "ログイン中のアカウントが付けたリアクション。付けていないか、絵文字の無いいいねなら null。ブーストで載った投稿は、ブーストされた元の投稿へのリアクション"
    viewerReaction: ViewerReaction @lazy
    "ログイン中のアカウントがブーストしているか。フォロワー限定などブーストできない投稿は null。ブーストで載った投稿は、ブーストされた元の投稿のブースト"
    boostedByMe: Boolean
    "setLiked と setBoosted に渡す id。ブーストで載った投稿は、ブーストされた元の投稿を指す"
    reactionPostId: TimelinePostId!
    "他のサーバーから届いたブーストの数。他のサーバーの投稿は、相手のサーバーが出している数を Query.postCounts で取ったことがあればその数で、無ければ null"
    boostCount: Int
    "フォローしている相手か自分のブーストとして載った投稿なら、ブーストした相手。author などほかの項目はブーストされた投稿のもの"
    boostedBy: Actor
    "投稿が載った購読先のグループ。ブーストならブーストした相手の購読先。メインなら null"
    followingGroupId: FollowingGroupId @lazy
    "返信なら true。ブーストで載った投稿は、ブーストされた元の投稿が返信か。返信先は Query.replyTarget で取る"
    hasReplyTarget: Boolean!
    "リプライの数。他のサーバーの投稿は、このサーバーが知っている返信と、Query.postCounts で取った相手のサーバーの数の大きい方"
    replyCount: Int!
    "スタンプの数を受け取っているか。他のサーバーの投稿はスタンプを受け取らないので false"
    stampCountsReceived: Boolean!
    "引用なら true。ブーストで載った投稿は、ブーストされた元の投稿が引用か。引用先は Query.quoteTarget で取る"
    hasQuoteTarget: Boolean!
    "投稿者が編集していれば true。ブーストで載った投稿は、ブーストされた元の投稿が編集されたか。編集前の版は UserInfo.postRevisions で取る。このサーバーの投稿は編集できないので false"
    edited: Boolean!
}

type PostRevisionPage {
    revisions: [PostRevision!]!
    nextCursor: String
}

"投稿のある時点の中身。それぞれ TimelinePost の同じ名前の項目と同じ意味"
type PostRevision {
    "版の並びの中でこの版を見分ける。同じ投稿の中でだけ一意"
    id: PostRevisionId!
    content: String!
    summary: String
    sensitive: Boolean!
    mentions: [PostMention!]!
    images: [PostImage!]!
    videos: [PostVideo!]!
    "今の版に入るカスタム絵文字。前の版にしか無かった絵文字は入らない"
    emojis: [CustomEmoji!]!
    "この版になった時刻。最初の版は投稿した時刻"
    revisedAt: String!
}

"投稿者、ブーストした相手、通知を送ってきた相手"
type Actor {
    "他のサーバーのアクターの URI。このサーバーのアカウントなら null"
    actorUri: String
    username: String!
    "このサーバーのアカウントなら null"
    host: String
    displayName: String!
    "displayName に入るカスタム絵文字。画像を中継できなければ空"
    displayNameEmojis: [CustomEmoji!]!
    "プロフィール画像の URL。無ければ null"
    iconUrl: String
}

type NotificationPage {
    notifications: [NotificationGroup!]!
    nextCursor: String
}

"通知カラムの 1 項目。お気に入りとブーストは投稿ごと・種類ごとにまとめ、フォローとメンションは 1 件ずつ"
type NotificationGroup {
    id: NotificationGroupId!
    kind: NotificationKind!
    "対象の投稿。FOLLOW では null。MENTION では宛てた投稿、ほかは自分の投稿"
    post: TimelinePost
    "新しく加わった順に数人まで。ブロックした相手は除く"
    recentActors: [NotificationActor!]!
    "ブロックした相手を除いた人数"
    actorCount: Int!
    createdAt: String!
    "最後に新しい相手が加わった時刻。通知カラムはこの新しい順に並ぶ"
    updatedAt: String!
}

type NotificationActor {
    actor: Actor!
    "FAVOURITE で付けた絵文字。絵文字の無いいいねと、ほかの種類では null"
    reaction: NotificationReaction
}

type NotificationReaction {
    "絵文字そのもの、またはカスタム絵文字の :name:"
    emoji: String!
    "カスタム絵文字の画像の URL。Unicode の絵文字か、画像を中継できないか、消されたこのサーバーの絵文字なら null"
    imageUrl: String
}

enum NotificationKind {
    FOLLOW
    MENTION
    FAVOURITE
    BOOST
}

"他のサーバーのカスタム絵文字。文字列の中の name を imageUrl の画像に置き換えて見せる"
type CustomEmoji {
    ":name: の形"
    name: String!
    imageUrl: String!
}

type PostStamp {
    "絵文字そのもの、またはカスタム絵文字の :name:"
    emoji: String!
    "カスタム絵文字の画像の URL。Unicode の絵文字か、画像を中継できないか、消されたこのサーバーの絵文字なら null"
    imageUrl: String
    count: Int!
    "このサーバーのカスタム絵文字なら、コロンを含めない shortcode。同じ絵文字で setReaction できる。Unicode の絵文字、他のサーバーの絵文字、消された絵文字では null"
    customEmojiShortcode: String
}

"投稿の本文にあるメンション。同じ名前でも別のサーバーの相手がいるので、本文の文字ではなく位置で宛先を決める"
type PostMention {
    "content でメンションが始まる位置。UTF-16 の単位で数える"
    start: Int!
    "content でメンションが終わる位置。この位置の文字は含まない"
    end: Int!
    "UserInfo.profile などに渡す user@host"
    acct: String!
}

type PostImage {
    url: String!
    "元の画像 URL に type=thumbnail を付けたサムネイル用 URL"
    thumbnailUrl: String!
    "画像の説明文。無ければ null"
    description: String
}

"他のサーバーの投稿に付いた動画。中継しないので、url は相手のサーバーのもの。https の動画だけを返す"
type PostVideo {
    url: String!
    "動画の説明文。無ければ null"
    description: String
}

"投稿の本文にあるリンク先の OGP。取れなかった項目は null"
type LinkPreview {
    url: String!
    title: String
    siteName: String
    imageUrl: String
    "リンク先のサイトのアイコン。imageUrl が無いときにカードに出す"
    faviconUrl: String
}
