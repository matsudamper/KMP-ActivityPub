schema {
    query: Query
    mutation: Mutation
}

type Query {
    "GraphQL は query にフィールドが 1 つ要る。空実装"
    unused: Boolean
    "有効なセッションの Cookie が無ければ null"
    userInfo: UserInfo
    user(username: String!): User
    """
    名前の一部で、このサーバーのユーザーとフォローなどで受け取った他のサーバーのユーザーをまとめて探す。
    after には前回の nextCursor を渡す。
    `@user@host` の形なら、ログイン中に限りそのホストのユーザーを WebFinger で引く
    """
    searchUsers(query: String!, after: String): UserSearchResult!
    "ログイン中のアカウントのパスキー。ログインしていなければ null"
    passkeys: [RegisteredPasskey!] @lazy
    "ログイン中のアカウントにパスワードがあるか。ログインしていなければ null"
    hasPassword: Boolean @lazy
}

type RegisteredPasskey {
    id: PasskeyCredentialId!
    name: String!
}

type Mutation {
    user: UserMutation!
}
