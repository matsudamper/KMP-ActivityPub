"外から見えるユーザーの情報"
type User {
    username: String!
    "プロフィール画像の URL。未設定なら null"
    iconUrl: String
}

type UserProfile {
    user: SearchedUser!
    "ヘッダー画像の URL。未設定か、このサーバーのユーザーなら null"
    headerUrl: String
    "プロフィールの説明文。プレーンテキスト"
    biography: String
    "プロフィールのリンク集。並べた順。他のサーバーのユーザーのものは受け取っていないので空"
    links: [ProfileLink!]!
    posts: [ProfilePost!]!
}

type ProfileLink {
    name: String!
    url: String!
}

type ProfilePost {
    content: String!
    publishedAt: String!
    summary: String
    sensitive: Boolean!
    "OGP を UserInfo.linkPreviews で取るときに postId に渡す id。取れない投稿は null"
    linkPreviewId: ID
    "UserInfo.post で個別投稿画面を開くときの id。開けない投稿は null"
    postId: ID
    "ログイン中のアカウントの投稿なら deleteNote に渡す id。消せない投稿は null"
    deletableNoteId: ID
    "本文にあるカードにするリンク。本文に出てくる順で、UserInfo.linkPreviews と同じ並び"
    linkUrls: [String!]!
    "投稿に付いた画像。付いた順"
    images: [PostImage!]!
    "本文と summary に入るカスタム絵文字。画像を中継できなければ空"
    emojis: [CustomEmoji!]!
    "他のサーバーから届いたお気に入りと、このサーバーのアカウントのいいねを合わせた数。他のサーバーの投稿は数を受け取らないので null"
    favouriteCount: Int
    "他のサーバーから届いたスタンプ。多く押された順。他のサーバーの投稿は受け取らないので空"
    stamps: [PostStamp!]!
    "共有するときに渡す投稿の URL。作れなければ null"
    url: String
    "他のサーバーから届いたブーストの数。他のサーバーの投稿は数を受け取らないので null"
    boostCount: Int
    "ログインしていないか、いいねできない投稿は null"
    like: ProfilePostLike
    "プロフィールの本人がブーストした投稿なら、その投稿者。本人の投稿は null"
    boostedNoteAuthor: PostAuthor
}

type PostAuthor {
    username: String!
    host: String!
    displayName: String!
    "displayName に入るカスタム絵文字。画像を中継できなければ空"
    displayNameEmojis: [CustomEmoji!]!
    "プロフィール画像の URL。無ければ null"
    iconUrl: String
}

type ProfilePostLike {
    "UserMutation.setLiked の postId に渡す id"
    postId: ID!
    "ログイン中のアカウントがいいねしているか"
    likedByMe: Boolean!
}

type UserSearchResult {
    users: [SearchedUser!]!
    "続きが無ければ null"
    nextCursor: String
}

"検索で見つかったユーザー"
type SearchedUser {
    actorUri: String
    "このサーバー内部でのフォロー状態"
    following: Boolean!
    "フォローを入れたグループ。フォローしていないか、ホームに入っていれば null"
    followingGroupId: FollowingGroupId
    username: String!
    host: String!
    "このサーバーのユーザーか"
    isLocal: Boolean!
    "表示名が無ければユーザー名"
    displayName: String!
    "displayName に入るカスタム絵文字。画像を中継できなければ空"
    displayNameEmojis: [CustomEmoji!]!
    iconUrl: String
}

type ActorList {
    users: [ListedActor!]!
    "続きが無ければ null"
    nextCursor: String
}

"""
フォロー・フォロワーの一覧の 1 人。フォローした相手のプロフィールは、こちらをフォローしてきたときにしか受け取らないので、
受け取っていなければ username や displayName が null になる
"""
type ListedActor {
    actorUri: String!
    "ログイン中のアカウントがフォローしているか"
    following: Boolean!
    "フォローを入れたグループ。フォローしていないか、ホームに入っていれば null"
    followingGroupId: FollowingGroupId
    username: String
    host: String!
    displayName: String
    "displayName に入るカスタム絵文字。画像を中継できなければ空"
    displayNameEmojis: [CustomEmoji!]!
    iconUrl: String
}
