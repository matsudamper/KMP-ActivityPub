type AdminMutation {
    "通るとセッションの Cookie が返る"
    login(password: String!): AdminLoginResult! @lazy

    "サーバー側のセッションも消える"
    logout: AdminSession! @lazy

    "ログインできるユーザーを登録する。ActivityPub のアクターとしても応答するようになる"
    addUser(query: AddUserQuery!): AdminAddUserResult! @lazy
}

type AdminLoginResult {
    session: AdminSession!
    failure: AdminLoginFailure
}

enum AdminLoginFailure {
    WRONG_PASSWORD

    "ADMIN_PASSWORD_HASH が未設定"
    NOT_CONFIGURED
}

input AddUserQuery {
    username: String!
    password: String!
}

type AdminAddUserResult {
    adminAccount: AdminAccount

    "登録できなかった場合だけ入る"
    failure: AdminAddUserFailure
}

type AdminAddUserFailure {
    "ユーザー名にあった使えない文字"
    unusableCharacters: [String!]

    "ユーザー名の文字数の上限を超えている場合の上限"
    maxLength: Int

    "ユーザー名の文字数の下限に足りない場合の下限"
    minLength: Int

    "同じ名前のユーザーが既にいる"
    isDuplicated: Boolean!

    "パスワードの文字数が下限に足りない場合の下限"
    passwordMinLength: Int
}
