type UserMutation {
    login(query: UserLoginQuery!): UserLoginResult! @lazy
    passkeyLoginOptions: String! @lazy
    passkeyLogin(credential: String!): UserPasskeyLoginResult! @lazy
    "ログインしていなければ null"
    passkeyRegistrationOptions: String @lazy
    registerPasskey(query: RegisterPasskeyQuery!): RegisterPasskeyResult! @lazy
    deletePasskey(id: PasskeyCredentialId!): DeletePasskeyResult! @lazy
    "パスワードが既に無くても成功する"
    deletePassword: DeletePasswordResult! @lazy
    "セッションが無くても成功する"
    logout: Boolean! @lazy
    "ログインしているアカウントで投稿し、フォロワーへの配信を積む。同じ requestId で送り直すと最初の投稿を返す"
    postNote(body: String!, requestId: String!): UserPostNoteResult! @lazy
}

input UserLoginQuery {
    username: String!
    password: String!
}

type UserLoginResult {
    failure: UserLoginFailure
}

enum UserLoginFailure {
    "ユーザーがいないか、パスワードが違う。"
    WRONG_USERNAME_OR_PASSWORD
}

type UserPasskeyLoginResult {
    failure: UserPasskeyLoginFailure
}

enum UserPasskeyLoginFailure {
    NOT_ACCEPTED
}

input RegisterPasskeyQuery {
    name: String!
    credential: String!
}

type RegisterPasskeyResult {
    failure: RegisterPasskeyFailure
}

enum RegisterPasskeyFailure {
    NOT_LOGGED_IN
    NOT_ACCEPTED
    ALREADY_REGISTERED
    INVALID_NAME
}

type DeletePasskeyResult {
    failure: DeletePasskeyFailure
}

enum DeletePasskeyFailure {
    NOT_LOGGED_IN
    "ログイン中のアカウントのパスキーではない"
    NOT_FOUND
    "パスワードが無く、最後のパスキーなので消すとログインできなくなる"
    LAST_LOGIN_METHOD
}

type DeletePasswordResult {
    failure: DeletePasswordFailure
}

enum DeletePasswordFailure {
    NOT_LOGGED_IN
    "パスキーが無いので消すとログインできなくなる"
    NO_PASSKEY
}

type UserPostNoteResult {
    "投稿の URL。投稿できなければ null"
    url: String
    failure: UserPostNoteFailure
}

enum UserPostNoteFailure {
    NOT_LOGGED_IN
    EMPTY_BODY
    "本文が長すぎる。上限は 500 文字"
    TOO_LONG
    "サーバーに DOMAIN が無く、投稿を配れない"
    FEDERATION_DISABLED
}
