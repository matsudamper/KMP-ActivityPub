"外から見えるユーザーの情報"
type User {
    username: String!
    "プロフィール画像の URL。未設定なら null"
    iconUrl: String
}

type UserProfile {
    user: SearchedUser!
    biography: String
    posts: [ProfilePost!]!
}

type ProfilePost {
    content: String!
    publishedAt: String!
}

type UserSearchResult {
    users: [SearchedUser!]!
    "続きが無ければ null"
    nextCursor: String
}

"検索で見つかったユーザー"
type SearchedUser {
    actorUri: String
    "このサーバー内部でのフォロー状態"
    following: Boolean!
    username: String!
    host: String!
    "このサーバーのユーザーか"
    isLocal: Boolean!
    "表示名が無ければユーザー名"
    displayName: String!
    iconUrl: String
}
