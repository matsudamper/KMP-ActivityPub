type UserInfo {
    """
    購読先 1 つの行を新しい順に返す。followingGroupId が null ならメイン（グループに入れていないフォローと自分の投稿）。
    after には前回の nextCursor を渡す。消された投稿も deleted を立てて返す
    """
    timeline(followingGroupId: FollowingGroupId, after: String, limit: Int!): TimelinePage @lazy
    "自分の投稿に届いたお気に入りとブーストを新しい順に返す。after には前回の nextCursor を渡す"
    notifications(after: String, limit: Int!): NotificationPage @lazy
    """
    postId の投稿の版を新しい順に返す。最初が今の版。postId には TimelinePost.id を渡す。ブーストで載った投稿は、ブーストされた元の投稿の版。
    after には前回の nextCursor を渡す。このサーバーが編集を受け取った分だけを返し、相手のサーバーへは取りに行かない。
    編集を受け取っていなければ今の版だけ。開けない投稿なら null
    """
    postRevisions(postId: TimelinePostId!, after: String, limit: Int!): PostRevisionPage @lazy
    id: UserId!
    "サーバーの ADMIN_USER_IDS に入っていれば true。管理画面に入れる"
    isAdmin: Boolean!
    "フォローを仕分けるグループ。作った順"
    followingGroups: [FollowingGroup!]! @lazy
    "どのグループにも入れていないフォローを入れるメインの名前"
    mainGroupName: String! @lazy
    """
    ブロックしている他のサーバーのホスト。新しくブロックした順。
    ブロックしたサーバーのアクターから自分宛てに届く投稿・お気に入り・ブースト・スタンプ・フォローは受け付けない。
    フォローしている相手の投稿など自分宛てでないものも、タイムラインと通知に出さない
    """
    blockedServers: [String!]! @lazy
    """
    ブロックしている他のサーバーのアカウント。新しくブロックした順。
    ブロックしたアカウントから自分宛てに届く投稿・お気に入り・ブースト・スタンプ・フォローは受け付けない。
    フォローしている相手がブーストしたものなど自分宛てでないものも、タイムラインと通知に出さない
    """
    blockedAccounts: [BlockedAccount!]! @lazy
}

type RemoteProfileRefreshState {
    "一度も始めていなければ null"
    progress: RemoteProfileRefreshProgress
}

type RemoteProfileRefreshProgress {
    running: Boolean!
    "始めたときに保存していた他のサーバーのユーザーの数"
    total: Int!
    refreshed: Int!
    "取りに行ったが取れなかった数"
    failed: Int!
    "相手のサーバーが続けて失敗したので取りに行かなかった数"
    skipped: Int!
    startedAt: String!
    "終わっていなければ null"
    finishedAt: String
}

"フォローを仕分けるグループ。どのグループにも入れていないフォローはメインに入る"
type FollowingGroup {
    id: FollowingGroupId!
    name: String!
}

"ブロックしている他のサーバーのアカウント"
type BlockedAccount {
    actorUri: String!
    "ブロックしたときの username@host"
    acct: String!
}

"投稿のリプライ・いいね・ブーストの数。それぞれ TimelinePost の同じ名前の項目と同じ意味"
type PostCounts {
    replyCount: Int!
    favouriteCount: Int
    boostCount: Int
}
