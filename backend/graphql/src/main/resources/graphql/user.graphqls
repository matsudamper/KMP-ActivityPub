"外から見えるユーザーの情報"
type User {
    username: String!
    "プロフィール画像の URL。未設定なら null"
    iconUrl: String
}

type UserProfile {
    user: SearchedUser!
    biography: String
    posts: [ProfilePost!]!
}

type ProfilePost {
    content: String!
    publishedAt: String!
    summary: String
    sensitive: Boolean!
    "OGP を UserInfo.linkPreviews で取るときに postId に渡す id。取れない投稿は null"
    linkPreviewId: ID
    "UserInfo.post で個別投稿画面を開くときの id。開けない投稿は null"
    postId: ID
    "ログイン中のアカウントの投稿なら deleteNote に渡す id。消せない投稿は null"
    deletableNoteId: ID
    "本文にあるカードにするリンク。本文に出てくる順で、UserInfo.linkPreviews と同じ並び"
    linkUrls: [String!]!
    "投稿に付いた画像。付いた順"
    images: [PostImage!]!
    "他のサーバーから届いたお気に入りの数。他のサーバーの投稿は数を受け取らないので null"
    favouriteCount: Int
    "他のサーバーから届いたスタンプ。多く押された順。他のサーバーの投稿は受け取らないので空"
    stamps: [PostStamp!]!
}

type UserSearchResult {
    users: [SearchedUser!]!
    "続きが無ければ null"
    nextCursor: String
}

"検索で見つかったユーザー"
type SearchedUser {
    actorUri: String
    "このサーバー内部でのフォロー状態"
    following: Boolean!
    username: String!
    host: String!
    "このサーバーのユーザーか"
    isLocal: Boolean!
    "表示名が無ければユーザー名"
    displayName: String!
    iconUrl: String
}

type ActorList {
    users: [ListedActor!]!
    "続きが無ければ null"
    nextCursor: String
}

"""
フォロー・フォロワーの一覧の 1 人。フォローした相手のプロフィールは、こちらをフォローしてきたときにしか受け取らないので、
受け取っていなければ username や displayName が null になる
"""
type ListedActor {
    actorUri: String!
    "ログイン中のアカウントがフォローしているか"
    following: Boolean!
    username: String
    host: String!
    displayName: String
    iconUrl: String
}
