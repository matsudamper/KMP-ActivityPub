schema {
    query: Query
    mutation: Mutation
}

type Query {
    "GraphQL は query にフィールドが 1 つ要る。空実装"
    unused: Boolean
    "有効なセッションの Cookie が無ければ null"
    userInfo: UserInfo
    "ログイン中のアカウントのパスキー。登録した順。ログインしていなければ null"
    passkeys: [RegisteredPasskey!] @lazy
}

type RegisteredPasskey {
    id: PasskeyCredentialId!
    name: String!
}

type Mutation {
    user: UserMutation!
}
