scalar UserId

type UserInfo {
    homeTimeline(cursor: String, limit: Int!): HomeTimeline @lazy
    """
    投稿の本文にあるリンク先の OGP。postId には HomeTimelinePost.id か ProfilePost.linkPreviewId を渡す。
    リンク先へ取りに行くので遅い。読めない投稿か、サーバーに DOMAIN が無ければ空
    """
    linkPreviews(postId: ID!): [LinkPreview!]! @lazy
    "ホームタイムラインの投稿を 1 件。id には HomeTimelinePost.id を渡す。読めない投稿なら null"
    post(id: ID!): HomeTimelinePost @lazy
    id: UserId!
    "サーバーの ADMIN_USER_IDS に入っていれば true。管理画面に入れる"
    isAdmin: Boolean!
    "フォローを仕分けるグループ。作った順"
    followingGroups: [FollowingGroup!]! @lazy
    "他のサーバーのユーザーのプロフィールを取り直す処理の進み具合。管理者でないか、一度も始めていなければ null"
    remoteProfileRefresh: RemoteProfileRefreshProgress @lazy
}

type RemoteProfileRefreshProgress {
    running: Boolean!
    "始めたときに保存していた他のサーバーのユーザーの数"
    total: Int!
    refreshed: Int!
    "取りに行ったが取れなかった数"
    failed: Int!
    "相手のサーバーが続けて失敗したので取りに行かなかった数"
    skipped: Int!
    startedAt: String!
    "終わっていなければ null"
    finishedAt: String
}

"フォローを仕分けるグループの識別子"
scalar FollowingGroupId

"フォローを仕分けるグループ。どのグループにも入れていないフォローはホームに入る"
type FollowingGroup {
    id: FollowingGroupId!
    name: String!
}
